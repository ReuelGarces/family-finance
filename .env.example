# Copy to .env and replace every placeholder before running the app.
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# npm run dev on your computer connects to localhost.
DATABASE_URL=postgresql://family_finance:replace-with-strong-password@localhost:5432/family_finance?schema=public

# Docker Compose connects to the database service by its internal hostname.
COMPOSE_DATABASE_URL=postgresql://family_finance:replace-with-strong-password@db:5432/family_finance?schema=public
POSTGRES_USER=family_finance
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=family_finance

# Used only to create the initial accounts on first boot.
# Use two distinct passwords with at least 12 characters.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Administrador
INITIAL_FAMILY_EMAIL=
INITIAL_FAMILY_PASSWORD=
INITIAL_FAMILY_NAME=Família
